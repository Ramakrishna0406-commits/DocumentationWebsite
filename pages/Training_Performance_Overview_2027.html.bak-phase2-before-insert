            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 16px;
        }

        .kpi {
            border: 1px solid #e4ebec;
            border-radius: 10px;
            padding: 18px;
            background: #fbfdfd;
        }

        .kpi-label {
            color: #718087;
            font-size: 13px;
            margin-bottom: 8px;
        }

        .kpi-value {
            color: #007367;
            font-size: 27px;
            font-weight: 700;
        }

        .table-placeholder {
            min-height: 150px;
            border: 2px dashed #d6e2e2;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #849397;
            background: #fafcfc;
        }

        .two-column {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .chart-placeholder {
            min-height: 280px;
            border: 1px solid #e2e9e9;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #849397;
            background: #fafcfc;
        }

