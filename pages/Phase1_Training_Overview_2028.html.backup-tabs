<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Phase 1 Training Overview</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 24px;
    font-family: Arial, Helvetica, sans-serif;
    background: #eef5f4;
    color: #263238;
}

/* HEADER */
.dashboard-header {
    background: linear-gradient(135deg, #007367, #005b52);
    color: white;
    padding: 26px 30px;
    border-radius: 18px 6px 18px 6px;
    margin-bottom: 22px;
    box-shadow: 0 8px 20px rgba(0, 115, 103, 0.20);
    position: relative;
    overflow: hidden;
}

.dashboard-header::after {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    right: -50px;
    top: -70px;
    border: 35px solid rgba(255,255,255,0.08);
    transform: rotate(45deg);
}

.header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.header-title {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

.header-subtitle {
    margin-top: 7px;
    font-size: 14px;
    opacity: 0.88;
}

.period-badge {
    background: rgba(255,255,255,0.14);
    border: 1px solid rgba(255,255,255,0.28);
    padding: 10px 16px;
    border-radius: 8px 18px 8px 18px;
    font-size: 13px;
    white-space: nowrap;
}

/* PHASE 1 OVERVIEW TABS */
.overview-tabs {
    display: flex;
    gap: 10px;
    margin: 0 0 22px 0;
    padding: 6px;
    background: white;
    border: 1px solid #dce8e6;
    border-radius: 12px 5px 12px 5px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    overflow-x: auto;
}

.overview-tab {
    flex: 1;
    min-width: 190px;
    padding: 14px 20px;
    border: 1px solid #d8e5e3;
    background: #f4f8f7;
    color: #536467;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.3px;
    cursor: pointer;
    white-space: nowrap;
    border-radius: 7px 18px 7px 18px;
    transition: all 0.2s ease;
}

.overview-tab:nth-child(2) {
    border-radius: 18px 7px 18px 7px;
}

.overview-tab:nth-child(3) {
    border-radius: 7px 18px 7px 18px;
}

.overview-tab:hover {
    background: #e3f0ee;
    color: #007367;
    transform: translateY(-2px);
}

.overview-tab.active {
    background: #007367;
    color: white;
    border-color: #007367;
    box-shadow: 0 5px 12px rgba(0,115,103,0.20);
}

.overview-tab.active:hover {
    background: #00665b;
    color: white;
}

@media (max-width: 700px) {
    .overview-tabs {
        gap: 6px;
    }

    .overview-tab {
        flex: 0 0 auto;
        min-width: 175px;
    }
}
/* KPI CARDS */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 22px;
}

.kpi {
    background: white;
    padding: 20px;
    min-height: 130px;
    position: relative;
    overflow: hidden;
    border: 1px solid #dce8e6;
    box-shadow: 0 6px 16px rgba(0,0,0,0.06);
    border-radius: 8px 22px 8px 22px;
}

.kpi:nth-child(2) {
    border-radius: 22px 8px 22px 8px;
}

.kpi:nth-child(3) {
    border-radius: 8px 22px 8px 22px;
}

.kpi:nth-child(4) {
    border-radius: 22px 8px 22px 8px;
}

.kpi::before {
    content: "";
    position: absolute;
    width: 70px;
    height: 70px;
    right: -25px;
    bottom: -25px;
    background: #e3f0ee;
    transform: rotate(45deg);
}

.kpi-label {
    font-size: 12px;
    color: #718083;
    text-transform: uppercase;
    letter-spacing: 0.7px;
}

.kpi-value {
    margin-top: 13px;
    font-size: 30px;
    font-weight: 700;
    color: #007367;
}

.kpi-note {
    margin-top: 7px;
    font-size: 11px;
    color: #899597;
}

/* SECTION TITLE */
.section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 25px 0 13px;
}

.section-title span {
    width: 6px;
    height: 25px;
    background: #007367;
    border-radius: 3px;
}

.section-title h2 {
    margin: 0;
    font-size: 18px;
    color: #344548;
}

/* ATTENDANCE PULSE */
.pulse-card {
    background: white;
    border: 1px solid #dce8e6;
    border-radius: 18px 6px 18px 6px;
    padding: 22px;
    box-shadow: 0 6px 16px rgba(0,0,0,0.05);
}

.pulse-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
}

.day-card {
    background: #f5f9f8;
    padding: 18px 10px;
    text-align: center;
    border-radius: 8px 18px 8px 18px;
    border: 1px solid #e0ebea;
}

.day-card:nth-child(even) {
    border-radius: 18px 8px 18px 8px;
}

.day {
    font-size: 12px;
    color: #718083;
    font-weight: 600;
}

.day-score {
    margin-top: 12px;
    font-size: 23px;
    font-weight: 700;
    color: #007367;
}

.day-bar {
    margin-top: 12px;
    height: 7px;
    background: #dce9e7;
    border-radius: 20px;
    overflow: hidden;
}

.day-bar span {
    display: block;
    height: 100%;
    background: #007367;
    border-radius: 20px;
}

/* CAMPUS */
.campus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
}

.campus {
    background: white;
    padding: 22px;
    border: 1px solid #dce8e6;
    box-shadow: 0 6px 16px rgba(0,0,0,0.05);
    border-radius: 7px 20px 7px 20px;
    position: relative;
}

.campus:nth-child(2) {
    border-radius: 20px 7px 20px 7px;
}

.campus:nth-child(3) {
    border-radius: 7px 20px 7px 20px;
}

.campus-name {
    font-size: 20px;
    font-weight: 700;
    color: #007367;
}

.campus-students {
    margin-top: 5px;
    font-size: 13px;
    color: #7b898b;
}

.campus-score {
    margin-top: 18px;
    font-size: 27px;
    font-weight: 700;
    color: #263238;
}

.campus-bar {
    margin-top: 10px;
    height: 8px;
    background: #e0eae9;
    border-radius: 20px;
    overflow: hidden;
}

.campus-bar span {
    display: block;
    height: 100%;
    background: #007367;
    border-radius: 20px;
}

/* PERFORMANCE */
.performance-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.25fr;
    gap: 16px;
}

.performance {
    background: white;
    padding: 22px;
    border: 1px solid #dce8e6;
    box-shadow: 0 6px 16px rgba(0,0,0,0.05);
    min-height: 190px;
}

.performance:nth-child(1) {
    border-radius: 20px 7px 20px 7px;
}

.performance:nth-child(2) {
    border-radius: 7px 20px 7px 20px;
}

.performance:nth-child(3) {
    border-radius: 20px 7px 20px 7px;
}

.performance-title {
    font-size: 15px;
    font-weight: 700;
    color: #007367;
    margin-bottom: 18px;
}

.main-score {
    font-size: 32px;
    font-weight: 700;
    color: #263238;
}

.score-row {
    display: flex;
    justify-content: space-between;
    padding: 9px 0;
    border-bottom: 1px solid #edf2f1;
    font-size: 13px;
}

.score-row strong {
    color: #007367;
}

/* BOTTOM BUTTONS */
.action-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 22px;
}

.action-button {
    padding: 17px 20px;
    background: #007367;
    color: white;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 6px 14px rgba(0,115,103,0.18);
    border-radius: 7px 20px 7px 20px;
    transition: transform 0.2s, box-shadow 0.2s;
}

.action-button:nth-child(2) {
    border-radius: 20px 7px 20px 7px;
}

.action-button:nth-child(3) {
    border-radius: 7px 20px 7px 20px;
}

.action-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0,115,103,0.25);
}

/* RESPONSIVE */
@media (max-width: 1000px) {
    .kpi-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .performance-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 700px) {
    body {
        padding: 12px;
    }

    .header-top {
        flex-direction: column;
        align-items: flex-start;
    }

    .kpi-grid,
    .campus-grid,
    .action-grid {
        grid-template-columns: 1fr;
    }

    .pulse-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}
</style>
</head>

<body>

<!-- HEADER -->
<div class="dashboard-header">
    <div class="header-top">
        <div>
            <div class="header-title">PHASE 1 TRAINING</div>
            <div class="header-subtitle">
                Training Progress & Performance Command Center
            </div>
        </div>

        <div class="period-badge">
            28 JUL 2026 → 01 AUG 2026
        </div>
    </div>
</div>

<!-- PHASE 1 OVERVIEW TABS -->
<div class="overview-tabs">

    <button class="overview-tab active" onclick="openOverviewTab('dashboard', this)">
        OVERVIEW DASHBOARD
    </button>

    <button class="overview-tab" onclick="openOverviewTab('attendance', this)">
        ATTENDANCE DAY-WISE DETAILS
    </button>

    <button class="overview-tab" onclick="openOverviewTab('performance', this)">
        CONSOLIDATED IN-TRAINING PERFORMANCE
    </button>

</div>

<!-- KPI -->
<div class="kpi-grid">

    <div class="kpi">
        <div class="kpi-label">Total Students</div>
        <div class="kpi-value">3,159</div>
        <div class="kpi-note">Across all campuses</div>
    </div>

    <div class="kpi">
        <div class="kpi-label">Overall Attendance</div>
        <div class="kpi-value">92.02%</div>
        <div class="kpi-note">5 training days</div>
    </div>

    <div class="kpi">
        <div class="kpi-label">Best Attendance Day</div>
        <div class="kpi-value">96.73%</div>
        <div class="kpi-note">28 July 2026</div>
    </div>

    <div class="kpi">
        <div class="kpi-label">Campuses</div>
        <div class="kpi-value">3</div>
        <div class="kpi-note">BLR • HYD • VSP</div>
    </div>

</div>

<!-- ATTENDANCE -->
<div class="section-title">
    <span></span>
    <h2>ATTENDANCE PULSE</h2>
</div>

<div class="pulse-card">

    <div class="pulse-grid">

        <div class="day-card">
            <div class="day">28 JUL</div>
            <div class="day-score">96.73%</div>
            <div class="day-bar"><span style="width:96.73%"></span></div>
        </div>

        <div class="day-card">
            <div class="day">29 JUL</div>
            <div class="day-score">94.65%</div>
            <div class="day-bar"><span style="width:94.65%"></span></div>
        </div>

        <div class="day-card">
            <div class="day">30 JUL</div>
            <div class="day-score">92.72%</div>
            <div class="day-bar"><span style="width:92.72%"></span></div>
        </div>

        <div class="day-card">
            <div class="day">31 JUL</div>
            <div class="day-score">90.27%</div>
            <div class="day-bar"><span style="width:90.27%"></span></div>
        </div>

        <div class="day-card">
            <div class="day">01 AUG</div>
            <div class="day-score">87.81%</div>
            <div class="day-bar"><span style="width:87.81%"></span></div>
        </div>

    </div>

</div>

<!-- CAMPUS -->
<div class="section-title">
    <span></span>
    <h2>CAMPUS PERFORMANCE</h2>
</div>

<div class="campus-grid">

    <div class="campus">
        <div class="campus-name">BLR</div>
        <div class="campus-students">863 Students</div>
        <div class="campus-score">89.10%</div>
        <div class="campus-bar"><span style="width:89.10%"></span></div>
    </div>

    <div class="campus">
        <div class="campus-name">HYD</div>
        <div class="campus-students">910 Students</div>
        <div class="campus-score">91.49%</div>
        <div class="campus-bar"><span style="width:91.49%"></span></div>
    </div>

    <div class="campus">
        <div class="campus-name">VSP</div>
        <div class="campus-students">1,386 Students</div>
        <div class="campus-score">94.73%</div>
        <div class="campus-bar"><span style="width:94.73%"></span></div>
    </div>

</div>

<!-- PERFORMANCE -->
<div class="section-title">
    <span></span>
    <h2>PERFORMANCE HUB</h2>
</div>

<div class="performance-grid">

    <div class="performance">
        <div class="performance-title">PRE-ASSESSMENT</div>
        <div class="main-score">--%</div>
        <div class="score-row">
            <span>Pre-Assessment Score</span>
            <strong>--%</strong>
        </div>
    </div>

    <div class="performance">
        <div class="performance-title">GRAND TEST SCORES</div>

        <div class="score-row">
            <span>Pseudocode Grand Test</span>
            <strong>--%</strong>
        </div>

        <div class="score-row">
            <span>Coding Grand Test</span>
            <strong>--%</strong>
        </div>
    </div>

    <div class="performance">
        <div class="performance-title">PHASE I – IN TRAINING SCORES</div>

        <div class="score-row">
            <span>Attendance</span>
            <strong>92.02%</strong>
        </div>

        <div class="score-row">
            <span>LC Scores</span>
            <strong>--%</strong>
        </div>

        <div class="score-row">
            <span>Pseudocode Assessment</span>
            <strong>--%</strong>
        </div>
    </div>

</div>

<!-- ACTION BUTTONS -->
<script>
function openOverviewTab(tab, button) {

    document.querySelectorAll(".overview-tab").forEach(function(btn) {
        btn.classList.remove("active");
    });

    if (button) {
        button.classList.add("active");
    }

    if (tab === "attendance") {
        window.location.href = "Phase1_Attendance_Daywise_2028.html";
        return;
    }

    if (tab === "dashboard") {
        window.location.href = "Phase1_Training_Overview_2028.html";
        return;
    }

    if (tab === "performance") {
        window.location.href = "Phase1_Training_Overview_2028.html";
        return;
    }
}
</script>
</body>
</html>






