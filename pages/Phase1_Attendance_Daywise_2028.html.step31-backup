<script>
let attendancePreviewData = [];
let attendanceHeaders = [];


function updateAttendanceDepartmentFilter() {
    const courseFilter = document.getElementById("courseFilter");
    const departmentFilter = document.getElementById("departmentFilter");

    if (!courseFilter || !departmentFilter) return;

    const selectedCourse = courseFilter.value;
    const currentDepartment = departmentFilter.value;

    const departments = selectedCourse
        ? (attendanceCourseDeptMapping[selectedCourse] || [])
        : Object.values(attendanceCourseDeptMapping).flat();

    departmentFilter.innerHTML =
        '<option value="">All Departments</option>' +
        departments.map(dept =>
            `<option value="${dept}">${dept}</option>`
        ).join("");

    if (departments.includes(currentDepartment)) {
        departmentFilter.value = currentDepartment;
    } else {
        departmentFilter.value = "";
    }
}

document.addEventListener("DOMContentLoaded", function () {
    const courseFilter = document.getElementById("courseFilter");

    if (courseFilter) {
        courseFilter.addEventListener("change", updateAttendanceDepartmentFilter);
        updateAttendanceDepartmentFilter();
    }
});
const attendanceCourseDeptMapping = {
    BTECH: [
        "CSE",
        "AI_DatSci",
        "EECE",
        "MECH",
        "CIVIL",
        "BIOTECHNOLOGY"
    ],
    BCA: [
        "CS"
    ]
};


const excelFileInput = document.getElementById("excelFile");`r`nif (excelFileInput) excelFileInput.addEventListener("change", function () {
    const file = this.files[0];
    if (!file) return;

    const status = document.getElementById("adminStatus");
    status.textContent = "Excel selected: " + file.name + ". Click Preview to load the student attendance sheet.";
});

document.getElementById("previewBtn").addEventListener("click", function () {
    const fileInput = document.getElementById("excelFile");
    const status = document.getElementById("adminStatus");

    if (!fileInput.files.length) {
        status.textContent = "Please select the Attendance Excel file first.";
        return;
    }

    const file = fileInput.files[0];
    const reader = new FileReader();

    reader.onload = function (e) {
        try {
            const workbook = XLSX.read(e.target.result, { type: "array" });

            if (!workbook.SheetNames.includes("student attendance")) {
                status.textContent = "Error: 'student attendance' sheet was not found.";
                return;
            }

            const worksheet = workbook.Sheets["student attendance"];

            const rows = XLSX.utils.sheet_to_json(worksheet, {
                header: 1,
                defval: ""
            });

            if (!rows.length) {
                status.textContent = "The student attendance sheet is empty.";
                return;
            }

            attendanceHeaders = rows[0].map(value => String(value).trim()); console.log('ATTENDANCE HEADERS:', attendanceHeaders);
            attendancePreviewData = rows.slice(1).filter(row =>
                row.some(cell => String(cell).trim() !== "")
            );

            renderAttendanceTable(attendancePreviewData);

            status.textContent =
                "Preview loaded successfully: " +
                attendancePreviewData.length +
                " student records.";
        } catch (error) {
            console.error(error);
            status.textContent = "Unable to read the Excel file.";
        }
    };

    reader.readAsArrayBuffer(file);
});

function renderAttendanceTable(rows) {
    const tbody = document.getElementById("attendanceBody");

    if (!rows.length) {
        tbody.innerHTML =
            '<tr><td colspan="18" class="empty-row">No attendance records found.</td></tr>';
        return;
    }

    tbody.innerHTML = rows.map(row => {
        const cells = [];

        for (let i = 0; i < 18; i++) {
            cells.push(
                "<td>" +
                escapeAttendanceHtml(row[i] ?? "") +
                "</td>"
            );
        }

        return "<tr>" + cells.join("") + "</tr>";
    }).join("");
}

function escapeAttendanceHtml(value) {
    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}
</script>
<script>
function openAttendanceTab(tab) {
    var overall = document.getElementById("attendanceOverallTab");
    var students = document.getElementById("attendanceStudentsTab");
    var tabs = document.querySelectorAll(".attendance-overview-tab");

    if (!overall || !students) return;

    if (tab === "overall") {
        overall.style.display = "block";
        students.style.display = "none";
        tabs.forEach(function(btn) { btn.classList.remove("active"); });
        if (tabs[0]) tabs[0].classList.add("active");
    } else {
        overall.style.display = "none";
        students.style.display = "block";
        tabs.forEach(function(btn) { btn.classList.remove("active"); });
        if (tabs[1]) tabs[1].classList.add("active");
    }
}

document.addEventListener("DOMContentLoaded", function() {
    openAttendanceTab("overall");
});


document.addEventListener("DOMContentLoaded", function () {
    const snapshotInput = document.getElementById("attendanceSnapshotInput");
    const viewSnapshotBtn = document.getElementById("viewAttendanceSnapshot");

    let attendanceSnapshotUrl = null;

    if (!snapshotInput || !viewSnapshotBtn) return;

    snapshotInput.addEventListener("change", function () {
        const file = this.files && this.files[0];

        if (!file) {
            viewSnapshotBtn.disabled = true;
            return;
        }

        if (!file.type.startsWith("image/")) {
            alert("Please select a JPG, JPEG or PNG image.");
            this.value = "";
            viewSnapshotBtn.disabled = true;
            return;
        }

        if (attendanceSnapshotUrl) {
            URL.revokeObjectURL(attendanceSnapshotUrl);
        }

        attendanceSnapshotUrl = URL.createObjectURL(file);
        viewSnapshotBtn.disabled = false;
    });

    viewSnapshotBtn.addEventListener("click", function () {
        if (!attendanceSnapshotUrl) {
            alert("Please upload an attendance snapshot first.");
            return;
        }

        window.open(attendanceSnapshotUrl, "_blank", "noopener,noreferrer");
    });
});
</script></body>
